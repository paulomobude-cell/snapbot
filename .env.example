USER_NAME = #YOUR_SNAPCHAT_USERNAME
USER_PASSWORD = #YOUR_SNAPCHAT_PASSWORD

# ---- server (npm start) ----
# Required: secret the frontend uses to connect. Make it long and random.
API_TOKEN=change-me
# Your Vercel URL(s), comma separated. Leave unset to allow any origin.
CORS_ORIGIN=https://your-app.vercel.app
# Messages disappear from the dashboard this many hours after they first show up
MESSAGE_TTL_HOURS=24
# How often chats are polled / fully re-checked for deletions (ms)
SYNC_INTERVAL_MS=4000
FULL_SYNC_INTERVAL_MS=60000
# Optional: POST every message:new / message:deleted / message:expired / status event here
WEBHOOK_URL=
# Optional: stop Snapchat showing "typing..." while the bot works
BLOCK_TYPING=false
