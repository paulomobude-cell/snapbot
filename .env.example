USER_NAME = #YOUR_SNAPCHAT_USERNAME
USER_PASSWORD = #YOUR_SNAPCHAT_PASSWORD

# ---- server (npm start) ----
# USER_NAME / USER_PASSWORD above are optional: if set, an account for them is
# created on first boot. Otherwise add accounts from the dashboard.

# Required: secret the frontend uses to connect. Make it long and random.
API_TOKEN=change-me
# Key used to encrypt remembered passwords + sign local media URLs (defaults to API_TOKEN).
SECRET_KEY=
# Separate persistent Chromium profile per account; size resources from observed Railway metrics
MAX_ACCOUNTS=3
# Your Vercel URL(s), comma separated. Leave unset to allow any origin.
CORS_ORIGIN=https://your-app.vercel.app

# Archive visible messages automatically, including ones later deleted/expired. 0 = no automatic TTL purge.
MESSAGE_TTL_HOURS=0
# How often chats are polled / fully re-checked (ms)
SYNC_INTERVAL_MS=4000
FULL_SYNC_INTERVAL_MS=60000

# ---- archived media ----
# Cloudflare R2 bucket for images/videos. If unset, media is kept on the data
# volume instead. The frontend only ever gets short-lived signed URLs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Backend's own public URL, used to sign media links when storing locally.
# On Railway this is auto-detected from RAILWAY_PUBLIC_DOMAIN.
PUBLIC_URL=
MEDIA_URL_TTL_SECONDS=21600
# Capture accessible tap-to-view snaps (opening marks them viewed on Snapchat)
CAPTURE_SNAPS=true
SNAPS_PER_SYNC=3

# Optional: POST every message / status event here
WEBHOOK_URL=
